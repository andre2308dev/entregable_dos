<section class="panel panel--login">
  <div class="login__icono">💬</div>
  <h1>Chat grupal</h1>
  <p class="subtitulo">Escribe tu nombre de usuario para unirte a la conversación.</p>

  <form action="/chat" method="GET" class="formulario formulario--simple">
    <div class="campo campo--completo">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" maxlength="30" placeholder="Ej: andres_osorio" autocomplete="off" required autofocus>
    </div>
    <button type="submit" class="btn btn--primario btn--bloque">Entrar al chat</button>
  </form>
</section>
